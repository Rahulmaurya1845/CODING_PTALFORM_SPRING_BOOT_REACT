# ============================================================
#  CodeJudge - environment variables
#  1) Copy this file to ".env"   (cp .env.example .env)
#  2) Change EVERY value marked CHANGE_ME
#  3) NEVER commit ".env" to GitHub (it is already in .gitignore)
# ============================================================

# ---------- MySQL (installed on your PC) ----------
DB_HOST=localhost
DB_PORT=3306
# The database is created automatically if it does not exist
DB_NAME=codejudge
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# ---------- Security ----------
# At least 32 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string_of_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# ---------- First admin account (created automatically on first start) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@codejudge.local
ADMIN_PASSWORD=CHANGE_ME_min_8_characters

# ---------- Web ----------
SERVER_PORT=8080
# Comma separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ---------- Code judge ----------
# Number of submissions judged in parallel (each one starts a Docker container)
JUDGE_WORKERS=2
# Languages to enable. Remove CPP if you do not want to download the ~1 GB gcc image.
JUDGE_LANGUAGES=PYTHON,JAVA,CPP,JAVASCRIPT
# Download the sandbox Docker images in the background at startup
JUDGE_PREPULL=true
# Extra milliseconds allowed for container start-up (raise it on a slow laptop)
JUDGE_STARTUP_ALLOWANCE_MS=1500
